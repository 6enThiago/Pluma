# ───────────── Dependencias ─────────────
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz

# ───────────── Secretos y configuración local ─────────────
# Nunca subir: contiene JWT_SECRET y la contraseña del admin
.env
.env.*
!.env.example

# ───────────── Base de datos local (SQLite) ─────────────
# Tiene usuarios, hashes de contraseña y posts reales
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ───────────── Logs ─────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ───────────── Pruebas y cobertura ─────────────
coverage/
.nyc_output/

# ───────────── Compilados / temporales ─────────────
dist/
build/
tmp/
temp/
*.tsbuildinfo
.cache/

# ───────────── Archivos de subida de usuarios (si se agregan) ─────────────
uploads/

# ───────────── Sistema operativo ─────────────
.DS_Store
Thumbs.db
desktop.ini

# ───────────── Editores / IDEs ─────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ───────────── Certificados y llaves ─────────────
*.pem
*.key
*.crt
